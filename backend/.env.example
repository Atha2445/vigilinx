# Edit these values for your client setup

# Keeps people logged in across restarts. Set to any long random text.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Email alerts configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here
ADMIN_EMAIL=admin@example.com

# ---- Live cameras via Frigate + Ollama (see ../deploy/frigate/README.md) ----
FRIGATE_BRIDGE_ENABLED=false
FRIGATE_URL=http://127.0.0.1:5000
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b

# Telegram alerts: bot token from @BotFather, chat ids comma separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Tuning (defaults shown)
# BRIDGE_CHECK_COOLDOWN=30        seconds between checks of one kind per camera
# BRIDGE_ALERT_COOLDOWN=120       seconds between alerts of one kind per camera
# BRIDGE_MIN_CONFIDENCE=0.5       verifier confidence needed to confirm
# BRIDGE_ALERT_WHEN_UNVERIFIED=true   still alert (marked unverified) if Ollama is down
# BRIDGE_VERIFY_FRAMES=6          frames Ollama looks at per check (use 3 on a CPU-only PC)
# OLLAMA_TIMEOUT=90               seconds to wait for Ollama (use 300 on a CPU-only PC)
# OLLAMA_IMAGE_SIZE=768           longest side of each frame sent (use 512 on a CPU-only PC)
